# FVM — the SDK cache. The version pin itself lives in .fvmrc, which is tracked.
.fvm/

# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
doc/api/

# VS Code: share the debug configs and the fvm SDK path, keep everything else
# local. A negation cannot reach inside an ignored directory, so this excludes
# the contents rather than the directory itself.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# Pub workspace: one lockfile at the root, none in members.
apps/*/pubspec.lock
packages/*/pubspec.lock

# Flutter tooling
apps/*/.flutter-plugins
apps/*/.flutter-plugins-dependencies
apps/*/ios/Flutter/Generated.xcconfig
apps/*/ios/Flutter/flutter_export_environment.sh
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/app/google-services.json
apps/*/ios/Runner/GoogleService-Info.plist
# FlutterFire CLI's own bookkeeping cache: which project id and app ids it last
# wrote into firebase_options.dart and google-services.json. Regenerated by every
# `flutterfire configure` run, so it should never have been tracked in the first
# place, and there is no placeholder worth committing in its stead — a cache with
# invented contents would just silently disagree with the next real run.
apps/*/firebase.json

# `firebase-tools --debug` writes a full request/response log of whatever command
# ran, including project ids and the signed-in account's email — nothing a public
# repo should carry. `firebase-debug.log` covers the exact name firebase-tools
# uses; the glob covers any future *-debug.log the CLI (or another tool) writes
# elsewhere in the tree.
firebase-debug.log
**/*-debug.log

# Patrol's generated test bundle — regenerated by every `patrol build`/`patrol
# test` and marked "DO NOT COMMIT TO VERSION CONTROL" in its own header.
apps/*/patrol_test/

# Firebase service account keys. These grant send rights on the whole project.
*service-account*.json

# The telemetry database. It defaults to sitting beside the service account key,
# which is often a directory inside this one, and it holds device ids and labels.
*.sqlite

# OS
.DS_Store

# Superpowers working notes: specs, implementation plans and the SDD ledgers.
# Kept on disk and out of the repository — they are a record of how the work was
# planned and reviewed, not part of the software. What they document that matters
# to a reader of this repo lives in the code, its doc comments and README.md.
docs/superpowers/
.superpowers/

# Worktrees this repo's agent sessions create. One was committed as a gitlink
# before this line existed (.claude/worktrees/fcm-notification-sandbox, added by
# b034f3e); this stops the next one repeating that.
.claude/worktrees/
