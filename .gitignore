# FVM — the SDK cache. The version pin itself lives in .fvmrc, which is tracked.
.fvm/

# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
doc/api/

# VS Code: share the debug configs and the fvm SDK path, keep everything else
# local. A negation cannot reach inside an ignored directory, so this excludes
# the contents rather than the directory itself.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# Pub workspace: one lockfile at the root, none in members.
apps/*/pubspec.lock
packages/*/pubspec.lock

# Generated by the firebase_functions build_runner builder, read by the CLI at
# deploy time. Regenerate with `melos run functions:build`.
apps/fcm_functions/functions.yaml

# The linux-x64 executable `firebase deploy` uploads. Built, never committed.
apps/fcm_functions/bin/server

# Service account key, needed to let the Functions emulator reach real FCM.
*-service-account.json

# Flutter tooling
apps/*/.flutter-plugins
apps/*/.flutter-plugins-dependencies
apps/*/ios/Flutter/Generated.xcconfig
apps/*/ios/Flutter/flutter_export_environment.sh
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/app/google-services.json
apps/*/ios/Runner/GoogleService-Info.plist

# Superpowers workflow artefacts. Both are notes about how the work was done,
# not the work itself — the code, its tests and the READMEs are the record.
#
# .superpowers/    ledgers, task briefs, implementer reports, review packages
# docs/superpowers/ brainstormed specs and implementation plans
.superpowers/
docs/superpowers/

# OS
.DS_Store
