# FVM — the SDK cache. The version pin itself lives in .fvmrc, which is tracked.
.fvm/

# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
doc/api/

# VS Code: share the debug configs and the fvm SDK path, keep everything else
# local. A negation cannot reach inside an ignored directory, so this excludes
# the contents rather than the directory itself.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# Pub workspace: one lockfile at the root, none in members.
apps/*/pubspec.lock
packages/*/pubspec.lock

# Flutter tooling
apps/*/.flutter-plugins
apps/*/.flutter-plugins-dependencies
apps/*/ios/Flutter/Generated.xcconfig
apps/*/ios/Flutter/flutter_export_environment.sh
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/app/google-services.json
apps/*/ios/Runner/GoogleService-Info.plist

# Firebase service account keys. These grant send rights on the whole project.
*service-account*.json

# The telemetry database. It defaults to sitting beside the service account key,
# which is often a directory inside this one, and it holds device ids and labels.
*.sqlite

# OS
.DS_Store

# Superpowers working notes: specs, implementation plans and the SDD ledgers.
# Kept on disk and out of the repository — they are a record of how the work was
# planned and reviewed, not part of the software. What they document that matters
# to a reader of this repo lives in the code, its doc comments and README.md.
docs/superpowers/
.superpowers/
