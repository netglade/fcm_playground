{
  // Debug configs for the Flutter app. `cwd` points at the app package because
  // the repo root is a pub workspace, not a Flutter project.
  //
  // The Dart extension finds the SDK via `dart.flutterSdkPath` in
  // settings.json, which points at the fvm pin — so none of this depends on
  // Flutter being on PATH.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fcm_app · Android phone",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      // `flutter run -d` matches a prefix of the device *id or name* — it does
      // not accept a platform, so "android" resolves to nothing. This is the
      // serial of the phone paired with this machine; run `fvm flutter devices`
      // and substitute your own, or use the "pick device" config below.
      "deviceId": "RZCY10GR1QA"
    },
    {
      "name": "fcm_app · Android phone (profile)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      // Profile mode: real-world performance, DevTools timeline available, no
      // hot reload. Debug-mode frame times on a phone are not representative.
      "flutterMode": "profile",
      "deviceId": "RZCY10GR1QA"
    },
    {
      "name": "fcm_app · pick device",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      "flutterMode": "debug"
      // No deviceId: VS Code uses the device selected in the status bar, or
      // prompts. Portable — use this one on a machine that isn't this one.
    },
    {
      "name": "fcm_app · Chrome",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      // Fixed port so the origin stays stable — Firebase authorised domains and
      // any CORS allowlist are configured per origin, and a random port makes
      // that unusable.
      "toolArgs": ["--web-port", "5555"]
    }
  ]
}
