{
  // Debug configs for the Flutter app. `cwd` points at the app package because
  // the repo root is a pub workspace, not a Flutter project.
  //
  // The Dart extension finds the SDK via `dart.flutterSdkPath` in
  // settings.json, which points at the fvm pin — so none of this depends on
  // Flutter being on PATH.
  //
  // None of these pins a `deviceId`: a serial is specific to one machine's
  // paired handset, so VS Code uses whatever is selected in the status bar and
  // prompts when nothing is. Run `fvm flutter devices` to see the choices, and
  // add `"deviceId": "<serial>"` locally if you tire of picking.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fcm_app · device",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "fcm_app · device (profile)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      // Profile mode: real-world performance, DevTools timeline available, no
      // hot reload. Debug-mode frame times on a phone are not representative.
      "flutterMode": "profile"
    },
    {
      "name": "fcm_app · Chrome",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/fcm_app",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      // Fixed port so the origin stays stable — Firebase authorised domains and
      // any CORS allowlist are configured per origin, and a random port makes
      // that unusable.
      "toolArgs": ["--web-port", "5555"]
    }
  ]
}
